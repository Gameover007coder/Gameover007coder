<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>University Login Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80') no-repeat center center fixed;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        
        .login-container {
            width: 100%;
            max-width: 450px;
            padding: 30px;
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }
        
        .university-logo {
            text-align: center;
            margin-bottom: 20px;
        }
        
        .university-logo img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        }
        
        .university-logo h2 {
            color: #2c3e50;
            margin-top: 10px;
            font-size: 24px;
            text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.8);
        }
        
        .login-form {
            display: flex;
            flex-direction: column;
        }
        
        .user-type {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
            gap: 15px;
        }
        
        .user-type label {
            padding: 10px 15px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
            color: #2c3e50;
        }
        
        .user-type input[type="radio"] {
            display: none;
        }
        
        .user-type input[type="radio"]:checked + label {
            background: #2c3e50;
            color: white;
            box-shadow: 0 0 10px rgba(44, 62, 80, 0.5);
        }
        
        .form-group {
            margin-bottom: 20px;
            position: relative;
        }
        
        .form-group i {
            position: absolute;
            left: 15px;
            top: 14px;
            color: #2c3e50;
        }
        
        .form-group input {
            width: 100%;
            padding: 12px 20px 12px 45px;
            border: none;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 8px;
            font-size: 16px;
            color: #2c3e50;
            outline: none;
            transition: all 0.3s ease;
        }
        
        .form-group input:focus {
            background: rgba(255, 255, 255, 0.9);
            box-shadow: 0 0 10px rgba(44, 62, 80, 0.3);
        }
        
        .captcha-container {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            gap: 10px;
        }
        
        .captcha-code {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 50px;
            background: rgba(25, 44, 62, 0.8);
            color: white;
            font-size: 22px;
            font-weight: bold;
            letter-spacing: 5px;
            border-radius: 8px;
            user-select: none;
        }
        
        .captcha-input {
            flex: 1;
        }
        
        .login-btn {
            padding: 12px;
            border: none;
            background: #2c3e50;
            color: white;
            border-radius: 8px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(44, 62, 80, 0.4);
        }
        
        .login-btn:hover {
            background: #1a2530;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(44, 62, 80, 0.5);
        }
        
        .login-btn:active {
            transform: translateY(0);
        }
        
        .forgot-password {
            text-align: center;
            margin-top: 15px;
        }
        
        .forgot-password a {
            color: #2c3e50;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        
        .forgot-password a:hover {
            text-decoration: underline;
            color: #1a2530;
        }
        
        .error-message {
            color: #e74c3c;
            text-align: center;
            margin-top: 15px;
            font-weight: 500;
            display: none;
        }
        
        .success-message {
            color: #27ae60;
            text-align: center;
            margin-top: 15px;
            font-weight: 500;
            display: none;
        }
        
        @media (max-width: 500px) {
            .login-container {
                padding: 20px;
            }
            
            .user-type {
                flex-direction: column;
                gap: 10px;
            }
            
            .captcha-container {
                flex-direction: column;
            }
            
            .captcha-code, .captcha-input {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="university-logo">
            <img src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80" alt="University Logo">
            <h2>University Login Portal</h2>
        </div>
        
        <form class="login-form" id="loginForm">
            <div class="user-type">
                <input type="radio" id="student" name="userType" value="student" checked>
                <label for="student">Student</label>
                Student.html
                
                <input type="radio" id="teacher" name="userType" value="teacher">
                <label for="teacher">Teacher</label>
                Teacher.html
                <input type="radio" id="admin" name="userType" value="admin">
                <label for="admin">Admin</label>
                admin_dashboard.html
            </div>
            
            <div class="form-group">
                <i class="fas fa-user"></i>
                <input type="text" id="userCode" placeholder="User ID" required>
            </div>
            
            <div class="form-group">
                <i class="fas fa-lock"></i>
                <input type="password" id="password" placeholder="Password" required>
            </div>
            
            <div class="captcha-container">
                <div class="captcha-code" id="captchaDisplay">A7B2</div>
                <div class="form-group captcha-input">
                    <input type="text" id="captchaInput" placeholder="Enter CAPTCHA" required>
                </div>
            </div>
            
            <div class="error-message" id="errorMessage">
                Invalid credentials. Please try again.
            </div>
            
            <div class="success-message" id="successMessage">
                Login successful! Redirecting...
            </div>
            
            <button type="submit" class="login-btn">Login</button>
            
            <div class="forgot-password">
                <a href="#">Forgot Password?</a>
            </div>
        </form>
    </div>

    <script>
        // User database (in a real application, this would be on the server)
        const users = {
            student: [
                { id: "S12345", password: "student123" },
                { id: "S67890", password: "pass123" },
                { id: "S2023001", password: "welcome" }
            ],
            teacher: [
                { id: "T1001", password: "teacher456" },
                { id: "T2002", password: "educator789" },
                { id: "T3003", password: "teach2023" }
            ],
            admin: [
                { id: "A001", password: "admin123" },
                { id: "A002", password: "securepass" },
                { id: "superadmin", password: "masterkey" }
            ]
        };

        // Get form and message elements
        const loginForm = document.getElementById('loginForm');
        const errorMessage = document.getElementById('errorMessage');
        const successMessage = document.getElementById('successMessage');

        // Simple CAPTCHA validation and credential checking
        loginForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Get form values
            const userType = document.querySelector('input[name="userType"]:checked').value;
            const userId = document.getElementById('userCode').value;
            const password = document.getElementById('password').value;
            const captchaInput = document.getElementById('captchaInput').value;
            const captchaDisplay = document.getElementById('captchaDisplay').textContent;
            
            // Hide previous messages
            errorMessage.style.display = 'none';
            successMessage.style.display = 'none';
            
            // Validate CAPTCHA
            if (captchaInput !== captchaDisplay) {
                errorMessage.textContent = 'CAPTCHA code does not match. Please try again.';
                errorMessage.style.display = 'block';
                generateCaptcha();
                return;
            }
            
            // Validate credentials
            const userList = users[userType];
            const user = userList.find(u => u.id === userId && u.password === password);
            
            if (user) {
                // Successful login
                successMessage.style.display = 'block';
                errorMessage.style.display = 'none';
                
                // Simulate redirect (in a real application, this would redirect to the appropriate dashboard)
                setTimeout(() => {
                    alert(`Login successful! Welcome, ${userId}. You are being redirected to the ${userType} dashboard.`);
                    loginForm.reset();
                    generateCaptcha();
                    successMessage.style.display = 'none';
                }, 1500);
            } else {
                // Failed login
                errorMessage.textContent = 'Invalid credentials. Please check your User ID and Password.';
                errorMessage.style.display = 'block';
                generateCaptcha();
            }
        });
        
        // Generate a simple CAPTCHA
        function generateCaptcha() {
            const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
            let captcha = '';
            for (let i = 0; i < 4; i++) {
                captcha += characters.charAt(Math.floor(Math.random() * characters.length));
            }
            document.getElementById('captchaDisplay').textContent = captcha;
            document.getElementById('captchaInput').value = '';
        }
        
        // Initial CAPTCHA generation
        generateCaptcha();
    </script>
</body>
</html>
